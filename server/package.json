{
  "name": "@keyring-notes/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=keyring-source --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "keyring": "node dist/cli.js",
    "keyring:dev": "tsx --conditions=keyring-source src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@mozilla/readability": "^0.6.0",
    "hono": "^4.13.13",
    "linkedom": "^0.18.13",
    "tar": "^7.5.22",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "@keyring-notes/core": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

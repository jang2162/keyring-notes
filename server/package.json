{
  "name": "@keyring-notes/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "keyring": "node dist/cli.js",
    "keyring:dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

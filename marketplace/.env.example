# 마켓 서버(marketplace/compose.yaml) 설정. 이 파일을 marketplace/.env 로 복사해 고친다.

# 호스트 쪽 바인드 주소와 포트. 인터넷에 직접 열지 않는다 — https 리버스 프록시 뒤에서.
MARKET_BIND=127.0.0.1
MARKET_PORT=8080

# index.json 을 다시 만드는 주기(초). 패키지 폴더를 마운트해 바꾸는 개인 마켓은 이만큼 뒤에 새 판이 보인다
MARKET_REBUILD_SECONDS=60

# 저장소 이름(index.json 의 name — 앱의 저장소 목록에 보인다)
MARKET_NAME=Keyring Notes

# KEYRING_DOMAIN의 HTTPS 인증서를 Let's Encrypt에서 자동으로 받는다(80·443 포트가 열려 있어야 한다).
# 사설망·시험용이면 .env에 CADDY_TLS=internal 을 넣어 Caddy 자체 CA로 발급한다.
(tls-acme) {
}
(tls-internal) {
	tls internal
}

{$KEYRING_DOMAIN} {
	import tls-{$CADDY_TLS:acme}
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy keyring:8787
}

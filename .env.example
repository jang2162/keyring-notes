# docker compose가 읽는 설정. 복사해서 .env로 쓴다.

# 원격으로 접속할 주소(https). 정하면 이 호스트 이름만 받고 로그인 쿠키에 Secure가 붙는다.
KEYRING_PUBLIC_URL=https://notes.example.com
# https 프로필(Caddy)이 인증서를 받을 도메인
KEYRING_DOMAIN=notes.example.com
# 사설망·시험용 자체 인증서: internal
# CADDY_TLS=internal

# Tailscale처럼 VPN 주소로 직접 붙을 때는 바인드 주소를 VPN 쪽으로(예: 100.x.y.z) 바꾸고 허용 호스트를 적는다.
# KEYRING_BIND=100.64.0.10
# KEYRING_ALLOWED_HOSTS=keyring.tailnet-name.ts.net,100.64.0.10

# 사내 위키 같은 사설 주소의 URL 수집 허용(기본 0)
# KEYRING_FETCH_ALLOW_PRIVATE=1
TZ=Asia/Seoul

# S3 호환 저장소(선택): 백업을 서버 밖에도 올리고, 큰 첨부를 내용 해시로 보관한다.
# AWS S3는 ENDPOINT를 비우고 REGION만, Cloudflare R2·MinIO 등은 ENDPOINT를 적는다.
# KEYRING_S3_BUCKET=my-notes
# KEYRING_S3_ACCESS_KEY_ID=
# KEYRING_S3_SECRET_ACCESS_KEY=
# KEYRING_S3_REGION=ap-northeast-2
# KEYRING_S3_ENDPOINT=https://<계정>.r2.cloudflarestorage.com
# KEYRING_S3_PREFIX=keyring/
# 큰 첨부(이미지·PDF)를 Git 대신 S3에 둔다(1). 기준 크기(KB)
# KEYRING_S3_BLOBS=1
# KEYRING_S3_BLOB_MIN_KB=256

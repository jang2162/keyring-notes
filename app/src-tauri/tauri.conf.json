{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keyring Notes",
  "version": "0.7.0",
  "identifier": "dev.keyringnotes.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../web run dev",
    "beforeBuildCommand": "pnpm --dir ../web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keyring Notes",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$DOCUMENT/**", "$APPDATA/**", "$HOME/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "로컬 우선 마크다운 노트",
    "longDescription": "기기 안의 마크다운 파일로 서버 없이 쓰고, 원하면 자체 호스팅한 Keyring Notes 서버와 동기화하는 노트 앱",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
